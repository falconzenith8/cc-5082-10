<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Headless batch entry point for the engine-free lifecycle core and the object-reuse sample.
    It compiles only Assets/Lifecycle/Core (noEngineReferences) and Tools/CoreTests, so it runs in
    CI and on a clean checkout with no Unity editor, no loaded assets, and no prior test state.
    Run it with: dotnet run plus the project path, then optional flags such as category=reuse.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>LifecycleCoreTests</AssemblyName>
    <RootNamespace>Lifecycle.CoreTests</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>CS0168;CS0219;CS0414;CS0649</NoWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Lifecycle/Core/*.cs" />
    <Compile Include="*.cs" />
    <Compile Include="Cli/*.cs" />
    <Compile Include="Faults/*.cs" />
    <Compile Include="Fixtures/*.cs" />
    <Compile Include="Scenarios/*.cs" />
  </ItemGroup>
</Project>
